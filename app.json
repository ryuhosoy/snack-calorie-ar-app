{
  "expo": {
    "name": "SnackCalorieAR",
    "slug": "snack-calorie-ar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "snackcaloriear",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ryuhosoy.snackcaloriear",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "お菓子の棚を写して、各商品のカロリーをARで表示するためにカメラを使います。",
        "UIRequiredDeviceCapabilities": [
          "arkit"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "おかしカロリーAR"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "19b021a6-627d-4348-a9ab-7e14689e6799"
      }
    }
  }
}
